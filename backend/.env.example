# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/buildscape

# Auth
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Upstash Redis cache; also required for shared AI rate limits in production when AI is enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Project AI guide using Gemini (server-side only; never expose this key to the frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
